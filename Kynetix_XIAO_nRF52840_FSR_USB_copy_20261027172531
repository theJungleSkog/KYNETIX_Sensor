/*
  KYNETIX | Five-FSR ground-contact prototype
  Board: Seeed Studio XIAO nRF52840 Sense
  Arduino board core: Seeed nRF52 mbed-enabled Boards

  Each FSR voltage divider:
    XIAO 3V3 -> FSR -> signal junction -> 10k resistor -> GND
                           signal junction -> XIAO analog pin

  Sensor mapping (same CSV column order as the Kynetix HTML dashboard):
    S1 heel            -> A0 / D0
    S2 first met       -> A1 / D1
    S3 fifth met       -> A2 / D2
    S4 lateral midfoot -> A3 / D3
    S5 big toe         -> A4 / D4 (also SDA: do not use I2C simultaneously)

  MODE 0 -> Arduino Serial Plotter: sensor channels plus contact flag
  MODE 1 -> Arduino Serial Monitor: step timing summary
  MODE 2 -> Kynetix dashboard / CSV: t_ms,S1,S2,S3,S4,S5,contact

  Keep all five FSRs unloaded for two seconds immediately AFTER RESET.
  USB connection itself does not necessarily restart the microcontroller.

  Analog readings converted into approximate millivolt-equivalent units
  assuming a nominal 0...3.3 V span. This is NOT precision voltage or
  calibrated plantar pressure. Retune thresholds against actual hardware.
*/

const int MODE = 2;
const int PINS[] = {A0, A1, A2, A3, A4};
const char* NAMES[] = {"S1", "S2", "S3", "S4", "S5"};
const int N = 5;

const uint32_t PERIOD_US        = 10000;   // 100 Hz
const int      ON_MV            = 150;     // approximate mV-equivalent signal rise
const int      OFF_MV           = 75;
const uint32_t MIN_CONTACT_MS   = 80;
const int      BASELINE_SAMPLES = 200;     // about 2 seconds at 100 Hz

// Nominal ADC conversion only; verify against a known test voltage if
// voltage accuracy is needed. GCT should be validated experimentally.
const float MV_PER_COUNT = 3300.0f / 4095.0f;

float baseline[N];
uint32_t next_t;
bool inContact = false;
uint32_t contactStart = 0;
uint32_t prevStart = 0;
uint32_t prevEnd = 0;
bool havePrev = false;
uint32_t stepCount = 0;
uint32_t sumContactMs = 0;
int peakTotal = 0;

int readApproxMilliVolts(int pin) {
  return (int)(analogRead(pin) * MV_PER_COUNT + 0.5f);
}

void calibrateBaseline() {
  float sum[N] = {0};
  for (int k = 0; k < BASELINE_SAMPLES; ++k) {
    for (int i = 0; i < N; ++i) {
      sum[i] += readApproxMilliVolts(PINS[i]);
    }
    delay(10);
  }
  for (int i = 0; i < N; ++i) {
    baseline[i] = sum[i] / BASELINE_SAMPLES;
  }
}

void setup() {
  Serial.begin(115200);   // Native USB CDC; retained for browser compatibility
  analogReadResolution(12);
  // ESP32-specific analogSetAttenuation() intentionally REMOVED.

  if (MODE == 1 && Serial) {
    Serial.println("Keep insole unloaded: measuring baseline for 2 s...");
  }
  calibrateBaseline();

  if (MODE == 1 && Serial) {
    Serial.print("Baseline (approx mV):");
    for (int i = 0; i < N; ++i) {
      Serial.print(' '); Serial.print(NAMES[i]); Serial.print('=');
      Serial.print(baseline[i], 0);
    }
    Serial.println();
    Serial.println("Ready. Press each FSR to test.");
  } else if (MODE == 2 && Serial) {
    Serial.println("t_ms,S1,S2,S3,S4,S5,contact");
  }
  next_t = micros();
}

void reportStep(uint32_t endTime) {
  uint32_t contactMs = endTime - contactStart;
  stepCount++;
  sumContactMs += contactMs;

  Serial.print("Step "); Serial.print(stepCount);
  Serial.print(": contact "); Serial.print(contactMs); Serial.print(" ms");
  if (havePrev) {
    Serial.print(" | swing "); Serial.print(contactStart - prevEnd);
    Serial.print(" ms | stride "); Serial.print(contactStart - prevStart);
    Serial.print(" ms");
  }
  Serial.print(" | peak "); Serial.print(peakTotal);
  Serial.print(" nominal mV | avg contact ");
  Serial.print(sumContactMs / stepCount);
  Serial.println(" ms");
}

void loop() {
  if ((int32_t)(micros() - next_t) < 0) return;
  next_t += PERIOD_US;
  uint32_t now = millis();

  int load[N];
  int total = 0;
  for (int i = 0; i < N; ++i) {
    int v = readApproxMilliVolts(PINS[i]) - (int)baseline[i];
    load[i] = v > 0 ? v : 0;
    total += load[i];
  }

  if (!inContact && total > ON_MV) {
    inContact = true;
    contactStart = now;
    peakTotal = total;
  } else if (inContact) {
    if (total > peakTotal) peakTotal = total;
    if (total < OFF_MV) {
      inContact = false;
      if (now - contactStart >= MIN_CONTACT_MS) {
        if (MODE == 1 && Serial) reportStep(now);
        prevStart = contactStart;
        prevEnd = now;
        havePrev = true;
      }
    }
  }

  // Don't let serial writes block sampling when USB is disconnected.
  if (!Serial) return;

  if (MODE == 0) {
    for (int i = 0; i < N; ++i) {
      Serial.print(NAMES[i]); Serial.print(':'); Serial.print(load[i]);
      Serial.print(',');
    }
    Serial.print("Contact:");
    Serial.println(inContact ? 1000 : 0);
  } else if (MODE == 2) {
    Serial.print(now);
    for (int i = 0; i < N; ++i) {
      Serial.print(','); Serial.print(load[i]);
    }
    Serial.print(',');
    Serial.println(inContact ? 1 : 0);
  }
}
