    "import csv, os, time\n",
    "from datetime import datetime\n",
    "import serial\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "COLS = [\"timestamp\", \"run\", \"weight_g\", \"t_s\", \"ticks\", \"delta_ticks\", \"cap_pF\", \"delta_pF\", \"timeouts\"]\n",
    "\n",
    "try:\n",
    "    ser.close()        # if this cell is re-run, close the old connection first\n",
    "except NameError:\n",
    "    pass\n",
    "ser = serial.Serial(PORT, BAUD, timeout=0.1)\n",
    "print(f\"Connected to {PORT}. Waiting for the ESP32 baseline - don't touch the sensor...\")\n",
    "time.sleep(3)\n",
    "ser.reset_input_buffer()\n",
    "print(\"Ready.\")"
   ],
   "id": "cell-07"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 4 — Load the helper functions\n",
    "Just run this cell. It defines:\n",
    "- `rezero()` — takes a new baseline (sensor must be empty)\n",
    "- `record(weight_g)` — records readings for a weight that is already on the sensor and saves them to `CSV_FILE`\n",
    "- `calibrate()` — walks you through every weight in `WEIGHTS_G`, prompting you each time\n",
    "- `readings()` — numbered list of everything saved so far\n",
    "- `delete(n)` / `undo()` — remove a bad recording so it doesn't show up in the results"
   ],
   "id": "cell-08"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def _parse(line):\n",
    "    parts = line.strip().split(\",\")\n",
    "    if len(parts) != 6 or parts[1] == \"TIMEOUT\":\n",
    "        return None\n",
    "    try:\n",
    "        return [float(p) for p in parts]\n",
    "    except ValueError:\n",
    "        return None   # header or text line\n",
    "\n",
    "\n",
    "def rezero():\n",
    "    # Take a new baseline. NOTHING may be on the sensor.\n",
    "    ser.reset_input_buffer()\n",
    "    ser.write(b\"b\\n\")\n",
    "    end = time.time() + 3\n",
    "    got = False\n",
    "    while time.time() < end:\n",
    "        line = ser.readline().decode(errors=\"ignore\")\n",
    "        if line.startswith((\"Baseline\", \"ERROR\", \"WARNING\")):\n",
    "            print(line.strip()); got = True\n",
    "    if not got:\n",
    "        print(\"No baseline message received - check the firmware supports the 'b' command.\")\n",
    "\n",
    "\n",
    "def record(weight_g, seconds=None, settle=None, run=1, plot=True, save=True):\n",
    "    # Put the weight on FIRST, then call this. Adds the readings to CSV_FILE\n",
    "    # (save=False just measures, without writing anything).\n",
    "    seconds = SECONDS if seconds is None else seconds\n",
    "    settle  = SETTLE  if settle  is None else settle\n",
    "    ser.reset_input_buffer()\n",
    "    time.sleep(settle)              # let the reading settle\n",
    "    ser.reset_input_buffer()\n",
    "    rows, t0 = [], time.time()\n",
    "    while time.time() - t0 < seconds:\n",
    "        r = _parse(ser.readline().decode(errors=\"ignore\"))\n",
    "        if r:\n",
    "            rows.append(r)\n",
    "    if not rows:\n",
    "        print(\"No readings - check the port, CSV_MODE = true on the ESP32, and the wiring.\")\n",
    "        return None\n",
    "    d = np.array([r[4] for r in rows])\n",
    "    if not save:\n",
    "        print(f\"{weight_g}: change = {d.mean():+.4f} pF (not saved)\")\n",
    "        return d.mean()\n",
    "    new_file = not os.path.exists(CSV_FILE)\n",
    "    stamp = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n",
    "    with open(CSV_FILE, \"a\", newline=\"\") as f:\n",
    "        w = csv.writer(f)\n",
    "        if new_file:\n",
    "            w.writerow(COLS)\n",
    "        for t, ticks, dticks, cap, dpf, tmo in rows:\n",
    "            w.writerow([stamp, run, weight_g, t, ticks, dticks, cap, dpf, int(tmo)])\n",
    "    timeouts = int(sum(r[5] for r in rows))\n",
    "    print(f\"{weight_g} g: {len(rows)} readings, change = {d.mean():+.4f} pF (spread ±{d.std():.4f})\"\n",
    "          + (f\"  [{timeouts} timeouts]\" if timeouts else \"\"))\n",
    "    if plot:\n",
    "        plt.figure(figsize=(8, 2.5))\n",
    "        plt.plot(np.array([r[0] for r in rows]) - rows[0][0], d)\n",
    "        plt.xlabel(\"Time (s)\"); plt.ylabel(\"Change (pF)\"); plt.title(f\"{weight_g} g (run {run})\")\n",
    "        plt.grid(alpha=0.3); plt.show()\n",
    "    return d.mean()\n",
    "\n",
    "\n",
    "def calibrate(weights=None, repeats=None):\n",
    "    # Guided session: prompts you to place each weight, then records it.\n",
    "    weights = WEIGHTS_G if weights is None else weights\n",
    "    repeats = REPEATS   if repeats is None else repeats\n",
    "    print(f\"Saving to {os.path.abspath(CSV_FILE)}\")\n",
    "    for run in range(1, repeats + 1):\n",
    "        print(f\"\\n===== Run {run} of {repeats} =====\")\n",
    "        input(\"Remove everything from the sensor, then press Enter to re-zero...\")\n",
    "        rezero()\n",
    "        for wt in weights:\n",
    "            msg = (f\"\\nPlace {wt} g on the sensor (centered, hands off), then press Enter \"\n",
    "                   \"(type 's' to skip, 'q' to quit): \")\n",
    "            if wt == 0:\n",
    "                msg = \"\\nLeave the sensor EMPTY and press Enter to record 0 g (s = skip, q = quit): \"\n",
    "            ans = input(msg).strip().lower()\n",
    "            if ans == \"q\":\n",
    "                print(\"Stopped.\"); return\n",
    "            if ans == \"s\":\n",
    "                continue\n",
    "            while True:\n",
    "                saved = record(wt, run=run, plot=False)\n",
    "                ans = input(\"Enter = keep it, r = delete it and redo this weight: \").strip().lower()\n",
    "                if ans != \"r\":\n",
    "                    break\n",
    "                if saved is not None:\n",
    "                    undo(show=False)\n",
    "                input(f\"Set up {wt} g again (hands off), then press Enter to re-record...\")\n",
    "    print(\"\\nDone! Run Step 7 to see the results.\")\n",
    "\n",
    "\n",
    "# ---------- Deleting bad recordings ----------\n",
    "# A \"recording\" = everything one record() call saved (one weight, ~1000 rows).\n",
    "\n",
    "def _load():\n",
    "    if not os.path.exists(CSV_FILE):\n",
    "        return COLS, []\n",
    "    with open(CSV_FILE, newline=\"\") as f:\n",
    "        r = csv.DictReader(f)\n",
    "        return r.fieldnames, list(r)\n",
    "\n",
    "\n",
    "def _recordings(rows):\n",
    "    # Consecutive rows with the same timestamp + run + weight came from one record() call\n",
    "    groups = []\n",
    "    for row in rows:\n",
    "        key = (row[\"timestamp\"], row.get(\"run\", \"1\"), row[\"weight_g\"])\n",
    "        if groups and groups[-1][0] == key:\n",
    "            groups[-1][1].append(row)\n",
    "        else:\n",
    "            groups.append((key, [row]))\n",
    "    return groups\n",
    "\n",
    "\n",
    "def readings():\n",
    "    # Numbered list of every recording in CSV_FILE\n",
    "    groups = _recordings(_load()[1])\n",
    "    if not groups:\n",
    "        print(f\"No recordings in {CSV_FILE} yet.\"); return\n",
    "    print(f\"Recordings in {CSV_FILE}:\")\n",
    "    print(f\"{'#':>3}  {'saved at':19}  {'run':>3}  {'weight':>8}  {'rows':>5}  {'mean change':>12}\")\n",
    "    for i, ((stamp, run, wt), rows) in enumerate(groups, 1):\n",
    "        d = [float(r[\"delta_pF\"]) for r in rows]\n",
    "        print(f\"{i:>3}  {stamp:19}  {run:>3}  {wt:>6} g  {len(d):>5}  {np.mean(d):+11.4f} pF\")\n",
    "\n",
    "\n",
    "def delete(*numbers, show=True):\n",
    "    # delete(3) or delete(3, 7): removes those recordings (numbers from readings()).\n",
    "    # Deleted rows are moved to <CSV_FILE>_deleted.csv, not lost.\n",
    "    fields, rows = _load()\n",
    "    groups = _recordings(rows)\n",
    "    bad = [n for n in numbers if not (isinstance(n, int) and 1 <= n <= len(groups))]\n",
    "    if bad or not numbers:\n",
    "        print(f\"Can't delete {bad or 'nothing'} - pick numbers from 1 to {len(groups)} (run readings()).\"); return\n",
    "    trash = os.path.splitext(CSV_FILE)[0] + \"_deleted.csv\"\n",
    "    new_trash = not os.path.exists(trash)\n",
    "    with open(trash, \"a\", newline=\"\") as f:\n",
    "        tw = csv.DictWriter(f, fieldnames=fields)\n",
    "        if new_trash:\n",
    "            tw.writeheader()\n",
    "        for n in numbers:\n",
    "            tw.writerows(groups[n - 1][1])\n",
    "    with open(CSV_FILE, \"w\", newline=\"\") as f:\n",
    "        w = csv.DictWriter(f, fieldnames=fields)\n",
    "        w.writeheader()\n",
    "        for i, (_, grp) in enumerate(groups, 1):\n",
    "            if i not in numbers:\n",
    "                w.writerows(grp)\n",
    "    for n in sorted(set(numbers)):\n",
    "        stamp, run, wt = groups[n - 1][0]\n",
    "        print(f\"Deleted #{n}: {wt} g (run {run}, saved {stamp})\")\n",
    "    if show:\n",
    "        print(); readings()\n",
    "\n",
    "\n",
    "def undo(show=True):\n",
    "    # Deletes the most recent recording\n",
    "    n = len(_recordings(_load()[1]))\n",
    "    if n == 0:\n",
    "        print(\"Nothing to undo.\"); return\n",
    "    delete(n, show=show)\n",
    "\n",
    "print(\"Helpers loaded.\")"
   ],
   "id": "cell-09"
  },
